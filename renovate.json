{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["argocd", "kubernetes", "regex"],
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "assignees": ["chealion"],
  "prHourlyLimit": 10,
  "ignorePaths": ["archive/", "examples/"],
  "packageRules": [
    {
      "description": "Update ClickHouse and Keeper together",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "clickhouse/clickhouse-server",
        "clickhouse/clickhouse-keeper"
      ],
      "groupName": "clickhouse"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": ["/argocd/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/argocd/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process various dependencies",
      "managerFilePatterns": ["/argocd/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( registryUrl=(?<registryUrl>.*?))?\n .*: (?<currentValue>.*=?)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
